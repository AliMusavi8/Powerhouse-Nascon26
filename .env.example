# Copy to .env and fill in. Never commit .env.

# Team salt printed on the team slip. Used for HMAC signatures of events and receipts.
DAY1_SALT=replace-with-team-salt

# Optional. JWT signing secret; if empty it is derived from DAY1_SALT.
JWT_SECRET=

# Set inside docker-compose.yml for the api container (listed here for completeness).
# DATABASE_URL=postgresql://nascon:nascon@db:5432/nascon
# REDIS_URL=redis://redis:6379/0
# JWT_TTL_SECONDS=7200
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=10
